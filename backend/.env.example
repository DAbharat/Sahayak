# =============================================================================
# GovScheme Navigator — Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# AWS Core
# ---------------------------------------------------------------------------
# AWS region that supports Bedrock, Transcribe, Polly, and Textract.
# Recommended: us-east-1 or ap-south-1 (Mumbai, for India)
AWS_REGION=us-east-1

# If using a named AWS CLI profile instead of environment credentials.
# Leave blank to use the default credential chain (IAM Role, env vars, etc.)
AWS_PROFILE=

# ---------------------------------------------------------------------------
# Amazon Bedrock
# ---------------------------------------------------------------------------
# Model ID to use for the Converse API.
# Options (ensure model access is granted in your AWS account):
#   google.gemma-3-4b-it-v1:0               (Google Gemma 3 4B)
#   google.gemma-3-12b-it-v1:0              (larger Gemma model)
#   amazon.titan-text-express-v1             (Amazon native)
BEDROCK_MODEL_ID=google.gemma-3-4b-it-v1:0

# Max tokens for Bedrock responses
BEDROCK_MAX_TOKENS=1024

# Temperature for extraction (keep low for determinism)
BEDROCK_EXTRACTION_TEMPERATURE=0.1

# Temperature for explanations/drafts (slightly higher for natural language)
BEDROCK_GENERATION_TEMPERATURE=0.3

# Max retry attempts for transient Bedrock errors
BEDROCK_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Amazon Transcribe (Legacy / Fallback)
# ---------------------------------------------------------------------------
# S3 bucket where audio files are uploaded before transcription.
# Must be in the same region as AWS_REGION.
TRANSCRIBE_S3_BUCKET=

# Max seconds to wait for transcription job to complete
TRANSCRIBE_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Speech-to-Text (faster-whisper)
# ---------------------------------------------------------------------------
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small
# Device: cpu, cuda, or auto
WHISPER_DEVICE=cpu
# Compute type: int8, float16, float32
WHISPER_COMPUTE_TYPE=int8
# Beam size for decoding
WHISPER_BEAM_SIZE=5

# ---------------------------------------------------------------------------
# Amazon Polly
# ---------------------------------------------------------------------------
# Hindi voices available: Aditi, Kajal (neural, India region)
# Aditi is standard (all regions), Kajal is neural (limited regions)
POLLY_VOICE_ID=Aditi

# Engine: standard | neural
POLLY_ENGINE=standard

# ---------------------------------------------------------------------------
# Amazon Textract
# ---------------------------------------------------------------------------
# S3 bucket for document uploads (can be same as TRANSCRIBE_S3_BUCKET)
TEXTRACT_S3_BUCKET=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Allowed CORS origins (comma-separated)
# Example: http://localhost:3000,https://yourapp.com
CORS_ORIGINS=http://localhost:3000

# Maximum upload file size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760
